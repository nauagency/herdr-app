{
  "id": "root",
  "type": "row",
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "nauagency-brand"
          },
          "size": {
            "px": 46
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "resizable": true,
          "divider": {
            "width": 2,
            "color": "border"
          },
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "content": {
                "mod": "space-manager-spaces"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            },
            {
              "id": "agents",
              "type": "block",
              "content": {
                "mod": "space-manager-hostflow"
              },
              "size": {
                "weight": 1
              },
              "min": 90
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "nauagency-brand",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 69
          }
        }
      ],
      "size": {
        "px": 360
      },
      "min": 260,
      "max": 520,
      "background": "chrome",
      "resizable": true
    },
    {
      "id": "workspace",
      "type": "column",
      "children": [
        {
          "id": "workspace-actions",
          "type": "block",
          "content": {
            "mod": "nau-tabs-persistent",
            "props": {
              "actionsOnly": true
            }
          },
          "size": {
            "px": 42
          },
          "window_drag": true
        },
        {
          "id": "workspace-body",
          "type": "row",
          "children": [
            {
              "id": "flow-panel",
              "type": "block",
              "content": {
                "mod": "space-flow-board"
              },
              "size": {
                "weight": 1
              },
              "min": 500
            },
            {
              "id": "work",
              "type": "column",
              "resizable": true,
              "divider": {
                "width": 2,
                "color": "border"
              },
              "children": [
                {
                  "id": "main-preview",
                  "type": "block",
                  "content": {
                    "mod": "product-preview",
                    "props": {
                      "auto": true
                    }
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 180
                },
                {
                  "id": "main-chat",
                  "type": "block",
                  "content": {
                    "mod": "leader-chat"
                  },
                  "size": {
                    "weight": 1
                  },
                  "min": 180
                },
                {
                  "id": "status",
                  "type": "block",
                  "content": {
                    "mod": "workspace-status"
                  },
                  "size": {
                    "px": 28
                  }
                }
              ],
              "size": {
                "px": 360
              },
              "min": 300,
              "max": 620,
              "padding": 8,
              "gap": 8
            },
            {
              "id": "panel",
              "type": "column",
              "children": [
                {
                  "id": "panel-body",
                  "type": "stack",
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "files"
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "changes"
                      }
                    }
                  ],
                  "active": "files"
                }
              ],
              "size": {
                "px": 368
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "gap": 0,
          "divider": {
            "width": 1,
            "color": "border"
          }
        }
      ],
      "size": {
        "weight": 1
      }
    }
  ],
  "background": "canvas",
  "terminal_padding": [
    14,
    12
  ],
  "divider": {
    "width": 1,
    "color": "border"
  },
  "titlebar": "none",
  "traffic_lights": [
    12,
    16
  ]
}
