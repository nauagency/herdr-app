#!/usr/bin/env bash
# Build and package the Nauagency desktop app for the current native platform.
# Windows: dist/multi-agent-herdr-windows-x86_64.zip
# macOS:   dist/multi-agent-herdr-macos-aarch64.tar.gz
set -euo pipefail
cd "$(dirname "$0")/.."

version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -1)
case "$(uname -s)" in
  Darwin) os=macos ;;
  MINGW* | MSYS* | CYGWIN*) os=windows ;;
  *) echo "package-nauagency: run this on Windows or macOS" >&2; exit 1 ;;
esac
case "$(uname -m)" in
  arm64 | aarch64) arch=aarch64 ;;
  x86_64 | amd64) arch=x86_64 ;;
  *) echo "package-nauagency: unsupported CPU $(uname -m)" >&2; exit 1 ;;
esac
if [[ $os == macos && $arch != aarch64 ]]; then
  echo "package-nauagency: packaged macOS builds require Apple Silicon" >&2
  exit 1
fi

for required in LICENSE THIRD-PARTY-NOTICES; do
  [[ -s $required ]] || { echo "package-nauagency: missing $required" >&2; exit 1; }
done

echo "package-nauagency: Multi Agent Herdr $version for $os-$arch"
HERDR_APP_RELEASE=1 cargo build --release --locked
core_repo=${NAU_CORE_SOURCE:-../multi-agent-herdr-core}
[[ -f "$core_repo/crates/herdr-core/Cargo.toml" ]] || { echo "package-nauagency: missing Multi Agent Herdr Core at $core_repo" >&2; exit 1; }
if [[ $os == windows ]]; then
  powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "$(cygpath -w "$core_repo/scripts/fetch-conpty.ps1")" -Dest "$(cygpath -w "$core_repo/target/release")"
fi
cargo build --release --locked --manifest-path "$core_repo/Cargo.toml" -p herdr-core
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
mkdir -p dist

if [[ $os == windows ]]; then
  dir="$work/multi-agent-herdr"
  mkdir -p "$dir"
  cp target/release/herdr-app.exe "$dir/multi-agent-herdr.exe"
  cp "$core_repo/target/release/herdr-core.exe" "$dir/multi-agent-herdr-core.exe"
  cp -R "$core_repo/target/release/conpty" "$dir/conpty"
  cp assets/icons/herdr-ui-icon-clean.svg "$dir/multi-agent-herdr.svg"
  cp LICENSE THIRD-PARTY-NOTICES "$dir/"
  out="dist/multi-agent-herdr-windows-$arch.zip"
  rm -f "$out"
  export NAU_PACKAGE_STAGE
  export NAU_PACKAGE_OUT
  NAU_PACKAGE_STAGE=$(cygpath -w "$dir")
  NAU_PACKAGE_OUT=$(cygpath -w "$(pwd)/$out")
  powershell.exe -NoLogo -NoProfile -Command \
    'Compress-Archive -LiteralPath $env:NAU_PACKAGE_STAGE -DestinationPath $env:NAU_PACKAGE_OUT -CompressionLevel Optimal'
  unset NAU_PACKAGE_STAGE NAU_PACKAGE_OUT
  /c/Windows/System32/tar.exe -tf "$out" >/dev/null
else
  app="$work/Multi Agent Herdr.app"
  executable="Multi Agent Herdr"
  icon="MultiAgentHerdr.icns"
  mkdir -p "$app/Contents/MacOS" "$app/Contents/Resources"
  cp target/release/herdr-app "$app/Contents/MacOS/$executable"
  chmod +x "$app/Contents/MacOS/$executable"
  cp assets/icons/Herdr.icns "$app/Contents/Resources/$icon"
  cp LICENSE THIRD-PARTY-NOTICES "$app/Contents/Resources/"
  marketing=${version%%-*}
  IFS=. read -r major minor patch <<< "$marketing"
  revision=${version##*-nau.}
  [[ $revision =~ ^[0-9]+$ ]] || revision=0
  build_version="$major.$minor.$((patch * 100 + revision))"
  cat > "$app/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleExecutable</key><string>$executable</string>
  <key>CFBundleIdentifier</key><string>com.nauagency.multi-agent-herdr</string>
  <key>CFBundleName</key><string>Multi Agent Herdr</string>
  <key>CFBundleDisplayName</key><string>Multi Agent Herdr $version</string>
  <key>CFBundleIconFile</key><string>MultiAgentHerdr</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>$marketing</string>
  <key>CFBundleVersion</key><string>$build_version</string>
  <key>NSMicrophoneUsageDescription</key><string>Terminal agents running in Multi Agent Herdr can use the microphone.</string>
  <key>NSCameraUsageDescription</key><string>Terminal agents running in Multi Agent Herdr can use the camera.</string>
  <key>NSAppleEventsUsageDescription</key><string>Terminal agents running in Multi Agent Herdr can control other apps when you allow it.</string>
  <key>NSPrincipalClass</key><string>NSApplication</string>
  <key>NSHighResolutionCapable</key><true/>
  <key>LSEnvironment</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict></plist>
PLIST
  plutil -lint "$app/Contents/Info.plist"
  scripts/mac-sign "$app"
  codesign --verify --deep --strict "$app"
  out="dist/multi-agent-herdr-macos-$arch.tar.gz"
  rm -f "$out"
  tar -czf "$out" -C "$work" "Multi Agent Herdr.app"
  tar -tzf "$out" >/dev/null
fi

if command -v sha256sum >/dev/null; then
  sha256sum "$out"
else
  shasum -a 256 "$out"
fi
