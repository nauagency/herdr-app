#!/usr/bin/env bash
set -euo pipefail
[[ $(uname -s) == Darwin ]] || { echo 'This installer requires macOS.' >&2; exit 1; }
cd "$(dirname "$0")/.."

scripts/package-nauagency
archive="dist/multi-agent-herdr-macos-aarch64.tar.gz"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
tar -xzf "$archive" -C "$work"

apps="$HOME/Applications"
app="$apps/Multi Agent Herdr.app"
mkdir -p "$apps" "$HOME/.local/bin"
rm -rf "$app.new"
mv "$work/Multi Agent Herdr.app" "$app.new"
rm -rf "$app"
mv "$app.new" "$app"
ln -sfn "$app/Contents/MacOS/Multi Agent Herdr" "$HOME/.local/bin/multi-agent-herdr"
ln -sfn "$app/Contents/MacOS/Multi Agent Herdr" "$HOME/.local/bin/herdr-app"
/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister -f "$app"
echo "Installed $app. Quit and reopen Multi Agent Herdr to use the new build."
